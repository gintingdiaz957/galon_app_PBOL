<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="id.pbol.galon.DaftarPesananForm">
  <grid id="c1000" binding="panelUtama" layout-manager="GridBagLayout">
  <constraints>
    <xy x="20" y="20" width="1120" height="540"/>
  </constraints>
  <properties>
    <background color="16251388"/>
  </properties>
  <border type="empty">
    <size top="20" left="20" bottom="20" right="20"/>
  </border>
  <children>
    <component id="c1001" class="javax.swing.JLabel">
    <constraints>
      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
      <gridbag top="0" left="0" bottom="4" right="0" weightx="1" weighty="0"/>
    </constraints>
    <properties>
      <text value="Daftar Pesanan"/>
      <font size="25" style="1"/>
      <foreground color="1582650"/>
    </properties>
    </component>
    <component id="c1002" class="javax.swing.JButton" binding="btnKeluar">
    <constraints>
      <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
      <gridbag top="0" left="0" bottom="4" right="0" weightx="0" weighty="0"/>
    </constraints>
    <properties>
      <text value="Keluar"/>
    </properties>
    </component>
    <component id="c1003" class="javax.swing.JLabel" binding="lblAkun">
    <constraints>
      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
      <gridbag top="0" left="0" bottom="16" right="0" weightx="0" weighty="0"/>
    </constraints>
    <properties>
      <text value="Akun"/>
      <foreground color="4347253"/>
    </properties>
    </component>
    <component id="c1004" class="javax.swing.JLabel" binding="lblMenunggu">
    <constraints>
      <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
      <gridbag top="0" left="0" bottom="16" right="0" weightx="0" weighty="0"/>
    </constraints>
    <properties>
      <text value="Menunggu konfirmasi: —"/>
      <font size="14" style="1"/>
      <foreground color="1987239"/>
    </properties>
    </component>
    <grid id="c1005" layout-manager="FlowLayout" flow-align="0" hgap="8" vgap="0">
    <constraints>
      <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
      <gridbag top="0" left="0" bottom="12" right="0" weightx="0" weighty="0"/>
    </constraints>
    <properties>
      <opaque value="false"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="c1006" class="javax.swing.JToggleButton" binding="btnAktif">
      <constraints/>
      <properties>
        <text value="Aktif"/>
      </properties>
      </component>
      <component id="c1007" class="javax.swing.JToggleButton" binding="btnRiwayat">
      <constraints/>
      <properties>
        <text value="Riwayat"/>
      </properties>
      </component>
      <component id="c1008" class="javax.swing.JButton" binding="btnMuatUlang">
      <constraints/>
      <properties>
        <text value="Muat ulang"/>
      </properties>
      </component>
    </children>
    </grid>
    <scrollpane id="c1009">
    <constraints>
      <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="8" fill="3" indent="0" use-parent-layout="false"/>
      <gridbag top="0" left="0" bottom="12" right="0" weightx="1" weighty="1"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="c1010" class="javax.swing.JTable" binding="tabelPesanan">
      <constraints/>
      <properties>
        <preferredScrollableViewportSize width="1060" height="335"/>
      </properties>
      </component>
    </children>
    </scrollpane>
    <component id="c1011" class="javax.swing.JLabel" binding="lblInformasi">
    <constraints>
      <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
      <gridbag top="0" left="0" bottom="8" right="0" weightx="0" weighty="0"/>
    </constraints>
    <properties>
      <text value="Aktif"/>
      <foreground color="4347253"/>
    </properties>
    </component>
    <grid id="c1012" layout-manager="FlowLayout" flow-align="0" hgap="8" vgap="0">
    <constraints>
      <grid row="4" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
      <gridbag top="0" left="0" bottom="0" right="0" weightx="0" weighty="0"/>
    </constraints>
    <properties>
      <opaque value="false"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="c1013" class="javax.swing.JButton" binding="btnBuatPesanan">
      <constraints/>
      <properties>
        <text value="Buat pesanan"/>
      </properties>
      </component>
      <component id="c1014" class="javax.swing.JLabel" binding="lblPengantar">
      <constraints/>
      <properties>
        <text value="Pengantar"/>
        <labelFor value="c1015"/>
      </properties>
      </component>
      <component id="c1015" class="javax.swing.JComboBox" binding="cmbPengantar">
      <constraints/>
      <properties>
        <preferredSize width="200" height="34"/>
      </properties>
      </component>
      <component id="c1020" class="javax.swing.JButton" binding="btnTambahPengantar">
      <constraints/>
      <properties>
        <text value="Tambah pengantar"/>
      </properties>
      </component>
      <component id="c1016" class="javax.swing.JButton" binding="btnTerimaTugaskan">
      <constraints/>
      <properties>
              <text value="Terima &amp;&amp; &amp;Tugaskan"/>
      </properties>
      </component>
      <component id="c1019" class="javax.swing.JButton" binding="btnBatalkan">
      <constraints/>
      <properties>
        <text value="Batalkan pesanan"/>
      </properties>
      </component>
      <component id="c1017" class="javax.swing.JButton" binding="btnMulaiAntar">
      <constraints/>
      <properties>
        <text value="Mulai antar"/>
      </properties>
      </component>
      <component id="c1018" class="javax.swing.JButton" binding="btnSelesaikan">
      <constraints/>
      <properties>
        <text value="Selesaikan"/>
      </properties>
      </component>
    </children>
    </grid>
  </children>
  </grid>
</form>
