<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="id.pbol.galon.LoginForm">
  <grid id="a1000" binding="panelUtama" layout-manager="GridBagLayout">
  <constraints>
    <xy x="20" y="20" width="430" height="340"/>
  </constraints>
  <properties>
    <background color="16251388"/>
  </properties>
  <border type="empty">
    <size top="30" left="30" bottom="30" right="30"/>
  </border>
  <children>
    <component id="a1001" class="javax.swing.JLabel">
    <constraints>
      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
      <gridbag top="0" left="0" bottom="4" right="0" weightx="0" weighty="0"/>
    </constraints>
    <properties>
      <text value="Galon Air"/>
      <font size="25" style="1"/>
      <foreground color="1582650"/>
    </properties>
    </component>
    <component id="a1002" class="javax.swing.JLabel">
    <constraints>
      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
      <gridbag top="0" left="0" bottom="23" right="0" weightx="0" weighty="0"/>
    </constraints>
    <properties>
      <text value="Masuk dengan akun kamu"/>
      <foreground color="4347253"/>
    </properties>
    </component>
    <component id="a1003" class="javax.swing.JLabel">
    <constraints>
      <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
      <gridbag top="0" left="0" bottom="5" right="0" weightx="0" weighty="0"/>
    </constraints>
    <properties>
      <text value="Email"/>
      <labelFor value="a1004"/>
    </properties>
    </component>
    <component id="a1004" class="id.pbol.galon.KolomContoh" binding="txtEmail">
    <constraints>
      <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
      <gridbag top="0" left="0" bottom="13" right="0" weightx="1" weighty="0"/>
    </constraints>
    <properties>
      <columns value="24"/>
    </properties>
    </component>
    <component id="a1005" class="javax.swing.JLabel">
    <constraints>
      <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
      <gridbag top="0" left="0" bottom="5" right="0" weightx="0" weighty="0"/>
    </constraints>
    <properties>
      <text value="Kata sandi"/>
      <labelFor value="a1006"/>
    </properties>
    </component>
    <component id="a1006" class="javax.swing.JPasswordField" binding="txtPassword">
    <constraints>
      <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
      <gridbag top="0" left="0" bottom="3" right="0" weightx="1" weighty="0"/>
    </constraints>
    <properties>
      <columns value="24"/>
    </properties>
    </component>
    <component id="a1007" class="javax.swing.JButton" binding="btnMasuk">
    <constraints>
      <grid row="7" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
      <gridbag top="0" left="0" bottom="8" right="0" weightx="1" weighty="0"/>
    </constraints>
    <properties>
      <text value="Masuk"/>
    </properties>
    </component>
    <component id="a1008" class="javax.swing.JCheckBox" binding="chkTampilkan">
      <constraints>
        <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        <gridbag top="0" left="0" bottom="8" right="0" weightx="1" weighty="0"/>
      </constraints>
      <properties>
        <text value="Tampilkan kata sandi"/>
      </properties>
    </component>
    <component id="a1009" class="javax.swing.JButton" binding="btnDaftar">
      <constraints>
        <grid row="8" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        <gridbag top="0" left="0" bottom="8" right="0" weightx="1" weighty="0"/>
      </constraints>
      <properties>
        <text value="Daftar akun"/>
      </properties>
    </component>
  </children>
  </grid>
</form>
